# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# Which config to load: development | production | testing
FLASK_CONFIG=development

# Long random string. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Local dev uses SQLite automatically (dev.sqlite3). Override only if needed:
# DEV_DATABASE_URL=sqlite:///dev.sqlite3

# Production (PythonAnywhere MySQL). Format:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@SERVER/DATABASE
